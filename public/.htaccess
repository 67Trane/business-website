# Apache config for the prerendered Angular site (all-inkl shared hosting)

RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Consolidate hosts: www -> apex (avoids duplicate content across both hosts)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Every real route is prerendered as a directory (/, /impressum/, /datenschutz/),
# so Apache serves them directly. Unknown URLs get a genuine 404 status with the
# prerendered 404 page — no catch-all rewrite to index.html (that produced
# "soft 404s": every typo URL answered 200 with duplicate homepage content).
ErrorDocument 404 /404/index.html

# Text responses declare their encoding at the HTTP layer too,
# not only via the in-document <meta charset>
AddDefaultCharset UTF-8

<IfModule mod_headers.c>
  # Security headers (site is fronted by Cloudflare, which passes these through).
  # No Content-Security-Policy yet: Angular's hydration/event-replay uses inline
  # scripts, so a CSP needs dedicated testing before it can be enabled safely.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Hashed JS/CSS/font files never change -> cache for one year
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images keep their names -> cache for 30 days
  <FilesMatch "\.(webp|jpe?g|png|ico|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # HTML must always be revalidated so deployments show up immediately
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  # Compress text-based assets (fonts/images are already compressed)
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
